# BookEasy environment template.
# Copy to `.env` in the repository root for local development. The backend imports it automatically
# and the frontend (Vite) reads only the VITE_* keys from it. NEVER commit a real .env.
# In production, set these as environment variables in Render (backend) and Vercel (frontend, VITE_* only).

# ---------------------------------------------------------------------------
# Backend runtime
# ---------------------------------------------------------------------------
# dev (default) | prod
SPRING_PROFILES_ACTIVE=dev
PORT=8080
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080
# Comma-separated browser origins allowed to call the API (production: your Vercel domain(s) only)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Swagger UI / OpenAPI JSON. Defaults to true in dev, false in prod.
API_DOCS_ENABLED=true

# ---------------------------------------------------------------------------
# MySQL 8
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bookeasy
DB_USERNAME=bookeasy_app
DB_PASSWORD=change_me
# DISABLED | PREFERRED | REQUIRED | VERIFY_CA | VERIFY_IDENTITY  (prod default: REQUIRED)
DB_SSL_MODE=PREFERRED
DB_POOL_SIZE=10
# Integration tests wipe and re-create this schema on every run. Never point it at real data.
TEST_DB_NAME=bookeasy_test

# ---------------------------------------------------------------------------
# Authentication & security (see docs/authentication.md)
# ---------------------------------------------------------------------------
# Signs access tokens. At least 64 bytes. Generate: openssl rand -base64 64
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=14
# Encrypts 2FA secrets and keys OTP hashes. 32 random bytes, base64. Generate: openssl rand -base64 32
# Changing it invalidates every enrolled authenticator app and pending OTP.
DATA_ENCRYPTION_KEY=
# Refresh cookie Secure flag. Always true in prod (forced by the prod profile).
AUTH_COOKIE_SECURE=false
# 0 = use the socket address. Behind Vercel rewrite -> Render, use 2 (verify per docs/deployment.md).
CLIENT_IP_XFF_INDEX=0
# Google Sign-In: OAuth 2.0 "Web application" client ID (no client secret needed – ID-token flow)
GOOGLE_OAUTH_CLIENT_ID=
# One-time creation of the first Super Admin (docs/admin-setup.md). Remove both after use.
BOOTSTRAP_ADMIN_EMAIL=
# At least 32 characters. Generate: openssl rand -base64 32
BOOTSTRAP_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Google Maps Platform (Phase 6)
# ---------------------------------------------------------------------------
# Server key (Geocoding) – restrict by IP / API
GOOGLE_MAPS_SERVER_API_KEY=

# ---------------------------------------------------------------------------
# Razorpay (Phase 8) – use rzp_test_ keys until go-live
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# true only after Razorpay has activated Route (marketplace split settlements) on your account
RAZORPAY_ROUTE_ENABLED=false

# ---------------------------------------------------------------------------
# Notifications – see docs/integrations/*.md
# ---------------------------------------------------------------------------
# Dev only: with no provider set, write emails and OTP codes to the log instead of failing.
# Forced off in prod, where a missing provider makes sends fail visibly.
NOTIFICATIONS_DEV_LOG=true
# SMS / OTP via MSG91 (DLT-approved OTP template required in India)
SMS_PROVIDER=
SMS_API_KEY=
SMS_BASE_URL=https://control.msg91.com
SMS_OTP_TEMPLATE_ID=
# Name of the template variable that receives the code
SMS_OTP_VARIABLE=otp
# Email over SMTP (Brevo, Amazon SES, Zoho, …)
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=BookEasy
# WhatsApp Business API
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_SENDER_NUMBER=

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
# Local dev: relative to backend/. Render: mount a persistent disk and point this inside it, e.g. /var/data/uploads
FILE_STORAGE_PATH=./data/uploads
UPLOAD_MAX_FILE_SIZE=10MB
UPLOAD_MAX_REQUEST_SIZE=25MB

# ---------------------------------------------------------------------------
# Frontend (Vite) – these are PUBLIC: never put secrets in VITE_* variables
# ---------------------------------------------------------------------------
# Same-origin by default (Vite proxy in dev, Vercel rewrite in prod). Only override for special setups.
VITE_API_BASE_URL=/api/v1
# Browser key – restrict by HTTP referrer and to Maps JavaScript + Places APIs
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_OAUTH_CLIENT_ID=
VITE_RAZORPAY_KEY_ID=
